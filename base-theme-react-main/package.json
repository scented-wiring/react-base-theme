{
  "name": "cms-react-hubspot-academy-project",
  "description": "CMS React HubSpot Academy Lesson Project",
  "license": "Apache-2.0",
  "devDependencies": {
    "@hubspot/cli": "^6.4.0",
    "@hubspot/prettier-plugin-hubl": "latest",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.10",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.4.15",
    "yarpm": "^1.2.0"
  },
  "scripts": {
    "start": "cd cms-react-project/cms-react-app && yarpm start",
    "postinstall": "cd cms-react-project/cms-react-app && yarpm install",
    "lint:js": "eslint . --ext .js,.jsx",
    "prettier": "prettier . --check",
    "watch:hubl": "hs watch cms-react-theme react-test-theme",
    "upload:hubl": "hs upload cms-react-theme react-test-theme",
    "deploy": "hs project upload cms-react-project",
    "dev": "tailwindcss -i ./cms-react-theme/assets/css/modules-tailwind.css -o ./cms-react-theme/assets/css/tailwind/_tailwind-styles.css --watch"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "swiper": "^11.1.15"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
